rules_version = '2';

// Firestore Security Rules for the Factor accounting app.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// (or `firebase deploy --only firestore:rules` if you use the Firebase CLI).
//
// Every collection in this app contains private business data (clients,
// projects, invoices, payments, purchase invoices, VAT periods, counters).
// Only a signed-in Firebase Authentication user may read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {

    // Require an authenticated user for all access.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
