rules_version = '2';

// Firebase Storage Security Rules for the Factor accounting app.
//
// Deploy: Firebase Console -> Storage -> Rules -> paste -> Publish
// (or `firebase deploy --only storage` if you use the Firebase CLI).
//
// Holds inkoopfactuur-bijlagen (PDF's/foto's van leveranciersfacturen) under
// purchase-invoices/{purchaseId}/**. Only a signed-in Firebase Authentication
// user may read or write anything, and uploads are capped at 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
