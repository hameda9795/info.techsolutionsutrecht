# Copy to .env (chmod 600!) and fill in real values. Never commit .env.

DATABASE_URL=postgresql://factor_app:REPLACE_WITH_REAL_PASSWORD@my_database:5432/factor_db

# Generate with: node scripts/hash-password.mjs "your-password"
AUTH_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Comma-separated list of frontend origins allowed to call this API with cookies.
FRONTEND_ORIGINS=https://your-frontend.example.com

ATTACHMENTS_DIR=/data/attachments
PORT=3020
NODE_ENV=production
